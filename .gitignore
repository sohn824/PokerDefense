# ---------------------------------------------------------------
# Unity generated folders
# ---------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store tools plugin
/[Aa]ssets/AssetStoreTools*

# Auto-generated Unity documentation
/[Aa]ssets/Plugins/Editor/JetBrains*

# ---------------------------------------------------------------
# Visual Studio / Rider / VS Code
# ---------------------------------------------------------------
.vs/
.idea/
.vscode/
/[Aa]ssets/Plugins/Editor/JetBrains*.meta

# Generated project files (Unity regenerates these)
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------------------------------------------------------------
# Build artifacts
# ---------------------------------------------------------------
ExportedObj/
.consulo/
*.apk
*.aab
*.unitypackage
*.app

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Addressables / Burst
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
/[Ll]ibrary/com.unity.addressables/
*_BurstDebugInformation_DoNotShip*/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# ---------------------------------------------------------------
# OS files
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# Local generation outputs: audio backups, previews, validation, UI captures.
# Runtime audio in Assets/_Project/Audio and generators in Tools/Audio stay tracked.
/Artifacts/

# Python-generated cache files
__pycache__/
*.py[cod]

# Machine-local assistant permissions
/.claude/settings.local.json

# Unselected voice audition tooling and its local-only license copy.
# Keep the license with any distributed voice samples/choir renders in Artifacts.
/Tools/Audio/VOICE_LICENSE.txt
/Tools/Audio/fetch_voice_candidates.py

# Retired arrangements: every Game music slot now references bgm_combat.
/Assets/_Project/Audio/bgm_plan.wav
/Assets/_Project/Audio/bgm_plan.wav.meta
/Assets/_Project/Audio/bgm_boss.wav
/Assets/_Project/Audio/bgm_boss.wav.meta
/Assets/_Project/Audio/bgm_result.wav
/Assets/_Project/Audio/bgm_result.wav.meta
