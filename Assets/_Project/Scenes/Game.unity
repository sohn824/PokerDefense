  m_text: "<b>\uC190\uD328\uB97C \uC644\uC131\uD558\uC138\uC694</b>\n5\uC7A5\uC758
    \uC871\uBCF4\uAC00 \uC18C\uD658 \uC720\uB2DB\uC744 \uACB0\uC815\uD569\uB2C8\uB2E4.\n\uAC01
    \uC790\uB9AC\uB294 \uD55C \uBC88 \uAD50\uCCB4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uAD50\uCCB4\uB97C
    \uC544\uB07C\uBA74 \uC720\uC9C0 \uBCF4\uB108\uC2A4 Chip\uC744 \uBC1B\uC2B5\uB2C8\uB2E4.\n\n<b>\uBCF4\uB4DC\uB97C
    \uAC15\uD654\uD558\uC138\uC694</b>\n\uAC19\uC740 \uC720\uB2DB\xB7\uAC19\uC740
    \uC131\uAE09\uB07C\uB9AC \uD569\uCE58\uBA74 \uC2B9\uAE09\uD569\uB2C8\uB2E4.\n\uB2E4\uB978
    \uC720\uB2DB\uC740 \uC790\uB9AC\uB97C \uBC14\uAFC0 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC0AC\uAC70\uB9AC\uC640
    \uC774\uBC88 \uC801\uC758 \uD2B9\uC131\uC744 \uD655\uC778\uD558\uC138\uC694.\n\n<b>\uB2E4\uC74C
    \uC190\uD328\uB97C \uC900\uBE44\uD558\uC138\uC694</b>\n\uC0C1\uC810\uC5D0\uC11C
    \uC0B0 \uCE74\uB4DC\uB294 \uCD5C\uB300 3\uC7A5 \uBCF4\uC720\uD569\uB2C8\uB2E4.\n\uC190\uD328\uC5D0
    \uB193\uC544\uB3C4 \uC720\uC9C0 \uBCF4\uB108\uC2A4\uB294 \uC904\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\n<b>\uCD94\uAC00
    \uAD50\uCCB4</b>\n\uAD50\uCCB4\uD588\uB358 \uCE74\uB4DC \uD55C \uC7A5\uC744 \uB2E4\uC2DC
    \uBC14\uAFC0 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uCE74\uB4DC \uC120\uD0DD \u2192
