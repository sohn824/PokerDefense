      m_Calls: []
  m_text: "<b>\uC190\uD328\uB85C \uC720\uB2DB\uC744 \uB9CC\uB4DC\uC138\uC694</b>\n\uBC14\uAFC0
    \uCE74\uB4DC\uB97C \uC120\uD0DD\uD558\uACE0 \uC77C\uBC18 \uAD50\uCCB4\uD569\uB2C8\uB2E4.\n\uC790\uB9AC\uB9C8\uB2E4
    \uD55C \uBC88, \uBE44\uC6A9 \uC5C6\uC774 \uBC14\uAFC0 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n<b>\uB9E4
    \uB77C\uC6B4\uB4DC \uC120\uD0DD \uAD50\uCCB4 1\uD68C</b>\n\uC77C\uBC18 \uAD50\uCCB4\uD588\uB358
    \uCE74\uB4DC \uD55C \uC7A5\uC744 \uB2E4\uC2DC \uBC14\uAFC9\uB2C8\uB2E4.\n\uD6C4\uBCF4
    3\uC7A5 \uC911 \uD55C \uC7A5\uC744 \uBC18\uB4DC\uC2DC \uACE8\uB77C\uC57C \uD569\uB2C8\uB2E4.\n\uB0A8\uC740
    \uAE30\uD68C\uB294 \uB2E4\uC74C \uB77C\uC6B4\uB4DC\uB85C \uC313\uC774\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\n<b>\uBCF4\uB4DC\uB97C
    \uC644\uC131\uD558\uC138\uC694</b>\n\uAC19\uC740 \uC720\uB2DB\xB7\uAC19\uC740
    \uC131\uAE09\uC744 \uD569\uCE58\uBA74 \uC2B9\uAE09\uD569\uB2C8\uB2E4.\n\uB2E4\uB978
    \uC720\uB2DB \uCE78\uC5D0\uB294 \uD655\uC778 \uD6C4 \uC0C8 \uC720\uB2DB\uC744
    \uB193\uC2B5\uB2C8\uB2E4.\n\uBCF4\uC2A4 \uBCF4\uC0C1 \uC2B9\uAE09\uAD8C\uC73C\uB85C\uB3C4
    \uD55C \uB2E8\uACC4 \uC62C\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n<b>\uC804\uD22C\uB97C
    \uBCF4\uACE0 \uBC30\uCE58\uB97C \uBC14\uAFB8\uC138\uC694</b>\n\uC801\uC758 \uD2B9\uC131\uACFC
    \uC0AC\uAC70\uB9AC\uB97C \uD655\uC778\uD558\uC138\uC694.\n\uC804\uD22C \uC911\uC5D0\uB3C4
    \uC720\uB2DB\uC744 \uC774\uB3D9\xB7\uD569\uCE60 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
